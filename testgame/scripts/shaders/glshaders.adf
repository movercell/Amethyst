Shaders {
    Vertex {
        Generic {
            Source "generic.vs"
        }
        Screenspace {
            Source "screenspace.vs"
        }
    }
    Fragment {
        Generic {
            Source "generic.fs"
        }
        Error {
            Source "error.fs"
        }
    }
    // These are fragment shaders that draw only depth.
    Depth {
        Generic {
            Source "generic.ds"
        }
    }
    Compute {
        STDGLModel_InstancePreprocess {
            Source "STDGLModel_InstancePreprocess.cs"
        }
        STDGLModel_InstanceReplicator {
            Source "STDGLModel_InstanceReplicator.cs"
        }
    }
    Programs {
        Engine_PBRGeneric {
            Shader_Vertex Generic
            Shader_Fragment Generic
            Shader_Depth Generic
            MaterialShouldBeBoundAtDepth 0
            MaterialLayout [
                {
                    "Name" "red"
                    "Type" "float"
                }
                {
                    "Name" "green"
                    "Type" "float"
                }
                {
                    "Name" "blue"
                    "Type" "float"
                    "Default" "0.0" // This is an optional field.
                }
            ]
        }
        Engine_Error {
            Shader_Vertex Generic
            Shader_Fragment Error
            Shader_Depth Generic
            MaterialShouldBeBoundAtDepth 0
            MaterialLayout []
        }
    }
}