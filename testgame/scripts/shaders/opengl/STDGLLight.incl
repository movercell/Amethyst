#include "helpers.incl"
#include "PBR.incl"

#define LIGHT_TYPE_NONE 0
#define LIGHT_TYPE_SPOT 1
#define LIGHT_TYPE_POINT 2
#define LIGHT_TYPE_END_MARKER 128

#define STDGLLIGHT_MAX_COUNT 4
#define STDGLLIGHT_ALLOC2D_DIMENSTIONS 8192.0f

struct STDGLLightData {
    mat4 ViewProjection;
    uint TextureSpacePosition;
    uint TextureSpaceSize;
    uint Type;
    float FOV;
    float Near;
    float Far;
    float Falloff_Constant;
    float Falloff_Linear;
    float Falloff_Quadratic;
    float Intensity;
    float Spot_InnerCutoff;
    float Spot_OuterCutoff;
    vec3 Color;
    vec3 LightPos;
    vec3 Spot_Direction;
};

layout (std140, binding = 2) buffer _LightBuffer {
    STDGLLightData Lights[STDGLLIGHT_MAX_COUNT];
} LightBuffer;

layout (binding = 15) uniform sampler2D LightAtlas;

// Type is a separate argument to allow for easier time for the compiler.
vec3 CalculateLightRadiance(STDGLLightData Light, const int Type, vec3 WorldPosition, vec3 LightDir, float FromFragToLightDistance) {
    // Distance attenuation.
    float BaseAttenuation = 1.0f / (Light.Falloff_Constant + FromFragToLightDistance * Light.Falloff_Linear + (FromFragToLightDistance * FromFragToLightDistance) * Light.Falloff_Quadratic);
    float Windowing = pow(clamp(1.0f - pow(FromFragToLightDistance / Light.Far, 4.0f), 0.0f, 1.0f), 2.0f);
    float DistanceAttenuation = BaseAttenuation * Windowing;

    if (Light.Type == LIGHT_TYPE_SPOT) {
        // Intensity attenuation.
        float Theta = dot(LightDir, normalize(-Light.Spot_Direction));
        float Epsilon = Light.Spot_InnerCutoff - Light.Spot_OuterCutoff;
        float IntensityAttenuation = clamp((Theta - Light.Spot_OuterCutoff) / Epsilon, 0.0f, 1.0f);

        return Light.Color * Light.Intensity * DistanceAttenuation * IntensityAttenuation;
    }

    if (Light.Type == LIGHT_TYPE_POINT) {
        return Light.Color * Light.Intensity * DistanceAttenuation;
    }

    return vec3(0.0f / 0.0f); // Fallback, return NaN.
}

float STDGLight_SampleSpotLightForShadows(STDGLLightData Light, vec3 point) {
    if (point.z < 0.0f || point.z > 1.0f ) return 0.0f;

    uvec2 TextureSize = uvec2(Light.TextureSpaceSize & 0xFFFFu, (Light.TextureSpaceSize >> 16u) & 0xFFFFu);
    ivec2 TexturePos = ivec2(uvec2((Light.TextureSpacePosition & 0xFFFFu) + uint(TextureSize.x * point.x), ((Light.TextureSpacePosition >> 16u) & 0xFFFFu) + uint(TextureSize.y * point.y)));

    float shadow = 0.0f;

    // Point.
    if (point.z > texelFetch(LightAtlas, TexturePos, 0).r) shadow += 1.0f;
    // Cardinal.
    if (point.z > texelFetch(LightAtlas, TexturePos + ivec2(1, 0), 0).r) shadow += 1.0f;
    if (point.z > texelFetch(LightAtlas, TexturePos + ivec2(-1, 0), 0).r) shadow += 1.0f;
    if (point.z > texelFetch(LightAtlas, TexturePos + ivec2(0, 1), 0).r) shadow += 1.0f;
    if (point.z > texelFetch(LightAtlas, TexturePos + ivec2(0, -1), 0).r) shadow += 1.0f;
    // Corners.
    if (point.z > texelFetch(LightAtlas, TexturePos + ivec2(1, 1), 0).r) shadow += 1.0f;
    if (point.z > texelFetch(LightAtlas, TexturePos + ivec2(-1, 1), 0).r) shadow += 1.0f;
    if (point.z > texelFetch(LightAtlas, TexturePos + ivec2(1, -1), 0).r) shadow += 1.0f;
    if (point.z > texelFetch(LightAtlas, TexturePos + ivec2(-1, -1), 0).r) shadow += 1.0f;
    // Cardinal(Far).
    if (point.z > texelFetch(LightAtlas, TexturePos + ivec2(2, 0), 0).r) shadow += 1.0f;
    if (point.z > texelFetch(LightAtlas, TexturePos + ivec2(-2, 0), 0).r) shadow += 1.0f;
    if (point.z > texelFetch(LightAtlas, TexturePos + ivec2(0, 2), 0).r) shadow += 1.0f;
    if (point.z > texelFetch(LightAtlas, TexturePos + ivec2(0, -2), 0).r) shadow += 1.0f;

    // Require at least two samples to pass.
    shadow = max(shadow - 2.0f, 0.0f) / 11.0f;

    return shadow;
}

vec3 STDGLight_ProcessSpotlight(vec3 Albedo, vec3 VertexNormal, vec3 TextureNormal, float Metalness, float Roughness, vec3 Position, STDGLLightData Light) {
    vec3 FromFragToLight = Light.LightPos - Position;
    float FromFragToLightDistance = length(FromFragToLight);
    if (FromFragToLightDistance > Light.Far) return vec3(0.0f);

    vec3 LightDir = normalize(FromFragToLight);

    vec3 Normal = VertexNormal; // TODO: Transform the vertex normal by texture normal
    vec3 FromFragToCamera = Camera.Pos - Position;
    vec3 CameraDir = normalize(FromFragToCamera);

    // First, do the shadow calculation.
    vec4 LightPos = Light.ViewProjection * vec4(Position + VertexNormal, 1.0f);
    vec3 projCoords = LightPos.xyz / LightPos.w;
    projCoords = vec3((projCoords * 0.5 + 0.5).xy, projCoords.z);

    float NormalDotLightDir = max(dot(Normal, LightDir), 0.0f);
    
    float Shadow = STDGLight_SampleSpotLightForShadows(Light, projCoords);
    if (Shadow == 0.0f) return vec3(0.0f); // Allow for skipping if the entire subgroup is in shadow.


    // PBR Lighting.
    vec3 F0 = vec3(0.04); 
    F0 = mix(F0, Albedo, Metalness);

    vec3 H = normalize(CameraDir + LightDir);
    vec3 radiance = CalculateLightRadiance(Light, LIGHT_TYPE_SPOT, Position, LightDir, FromFragToLightDistance);

    // Cook-torrance BRDF.
    float NDF = DistributionGGX(Normal, H, Roughness);        
    float G   = GeometrySmith(Normal, CameraDir, LightDir, Roughness);      
    vec3 F    = fresnelSchlick(max(dot(H, CameraDir), 0.0), F0);       
    
    vec3 kS = F;
    vec3 kD = vec3(1.0) - kS;
    kD *= 1.0 - Metalness;	  
    
    vec3 numerator    = NDF * G * F;
    float denominator = 4.0 * max(dot(Normal, CameraDir), 0.0) * max(dot(Normal, LightDir), 0.0) + 0.0001;
    vec3 specular     = numerator / denominator;

    return (kD * Albedo / PI + specular) * radiance * NormalDotLightDir * Shadow;
}