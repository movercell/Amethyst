#include "helpers.incl"

#define LIGHT_TYPE_NONE 0
#define LIGHT_TYPE_SPOT 1

#define STDGLLIGHT_MAX_COUNT 4096
#define STDGLLIGHT_ALLOC2D_DIMENSTIONS 8192.0f
#define STDGLLIGHT_AMOUNT_OF_ITERATIONS 16

struct STDGLLightData {
    mat4 ViewProjection;
    uint TextureSpacePosition;
    uint TextureSpaceSize;
    uint Type;
    float FOV;
    float Near;
    float Far;
    float Spot_InnerCutoff;
    float Spot_OuterCutoff;
    vec3 Color;
    vec3 LightPos;
    vec3 Spot_Direction;
};

layout (std140, binding = 2) buffer _LightBuffer {
    STDGLLightData Lights[STDGLLIGHT_MAX_COUNT];
} LightBuffer;

layout (binding = 15) uniform sampler2DShadow LightAtlas;

vec2 poissonDisk[16] = vec2[](
    vec2(-0.94201624, -0.39906216),
    vec2(0.94558609, -0.76890725),
    vec2(-0.094184101, -0.92938870),
    vec2(0.34495938, 0.29387760),
    vec2(-0.91588581, 0.45771432),
    vec2(-0.81544232, -0.87922466),
    vec2(-0.38277543, 0.27676845),
    vec2(0.97484398, 0.75648379),
    vec2(0.44323325, -0.97511554),
    vec2(0.53742981, -0.47373420),
    vec2(-0.26496911, -0.41893023),
    vec2(0.79197514, 0.19090188),
    vec2(-0.24188840, 0.99706507),
    vec2(-0.81409550, 0.91437590),
    vec2(0.19984126, 0.78641367),
    vec2(0.14383161, -0.14100790)
);

vec3 CalculateLightRadiance(STDGLLightData Light, vec3 WorldPosition, vec3 LightDir, float FromLightToFragDistance) {
    // TODO: Add intensity values to lights.
    float intensity = 5555.0f;

    // Distance attenuation.
    float BaseAttenuation = 1.0f / (FromLightToFragDistance * FromLightToFragDistance);
    float Windowing = pow(clamp(1.0f - pow(FromLightToFragDistance / Light.Far, 4.0f), 0.0f, 1.0f), 2.0f);
    float DistanceAttenuation = BaseAttenuation * Windowing;

    if (Light.Type == LIGHT_TYPE_SPOT) {
        // Intensity attenuation.
        float Theta = dot(LightDir, normalize(-Light.Spot_Direction));
        float Epsilon = Light.Spot_InnerCutoff - Light.Spot_OuterCutoff;
        float IntensityAttenuation = clamp((Theta - Light.Spot_OuterCutoff) / Epsilon, 0.0f, 1.0f);

        return Light.Color * intensity * DistanceAttenuation * IntensityAttenuation;
    }

    return Light.Color * intensity * DistanceAttenuation;
}

float STDGLight_SampleSpotLightForShadows(STDGLLightData Light, vec3 point, float NormalDotLightDir) {
    if (point.z < 0.0f || point.z > 1.0f ) return 0.0f;
    float TexturePosX = float(Light.TextureSpacePosition & 0xFFFFu) / STDGLLIGHT_ALLOC2D_DIMENSTIONS;
    float TexturePosY = float((Light.TextureSpacePosition >> 16u) & 0xFFFFu) / STDGLLIGHT_ALLOC2D_DIMENSTIONS;

    float TextureSizeX = float(Light.TextureSpaceSize & 0xFFFFu) / STDGLLIGHT_ALLOC2D_DIMENSTIONS;
    float TextureSizeY = float((Light.TextureSpaceSize >> 16u) & 0xFFFFu) / STDGLLIGHT_ALLOC2D_DIMENSTIONS;

    vec3 TruePoint = vec3(TexturePosX + (TextureSizeX * point.x), TexturePosY + (TextureSizeY * point.y), point.z);


    float Shadow = 0.0f;
    float bias = max(0.001 * (1.0f - NormalDotLightDir), 0.0003) * (1.0f - LinearizeDepth(TruePoint.z, Light.Near, Light.Far));
    for (int i = 0; i < STDGLLIGHT_AMOUNT_OF_ITERATIONS; i++) {
        Shadow += texture(LightAtlas, TruePoint + vec3(0.0f, 0.0f, bias) + vec3((poissonDisk[i] * vec2(TextureSizeX, TextureSizeY)) * 0.004f * (1.0f - LinearizeDepth(TruePoint.z, Light.Near, Light.Far) * 0.7f), 0.0f)) * NormalDotLightDir;
    }
    Shadow /= STDGLLIGHT_AMOUNT_OF_ITERATIONS;

    return Shadow;
}

vec3 STDGLight_ProcessSpotlight(vec3 Albedo, vec3 Normal, float Metalness, float Roughness, vec3 Position, int light) {
    STDGLLightData Light = LightBuffer.Lights[light];
    vec3 FromLightToFrag = Light.LightPos - Position;
    float FromLightToFragDistance = length(FromLightToFrag);
    if (FromLightToFragDistance > Light.Far) return vec3(0.0f);

    vec4 LightPos = Light.ViewProjection * vec4(Position, 1.0f);
    vec3 projCoords = LightPos.xyz / LightPos.w;
    projCoords = vec3((projCoords * 0.5 + 0.5).xy, projCoords.z);

    vec3 LightDir = normalize(FromLightToFrag);
    float NormalDotLightDir = max(dot(Normal, LightDir), 0.0f);
    
    float Shadow = STDGLight_SampleSpotLightForShadows(Light, projCoords, NormalDotLightDir);

    return Albedo * vec3(Shadow, Shadow, Shadow) * CalculateLightRadiance(Light, Position, LightDir, FromLightToFragDistance);
}