"MainMenuLayout" {
    "XOffsetRatio" "0.05"
    "YOffsetRatio" "0.4"
    "WidthRatio" "0.4"
    "ButtonHeightRatio" "0.12"
    "ButtonHeightCapRatio" "0.07"
    "ButtonStylishBarWidthRatio" "0.05"
    "ButtonStylishBarHoveredAppearanceSpeed" "5.0"
    "ButtonSelectedSizeIncrease" "0.3"
    "ButtonSelectedBackgroundAlpha" "0.2"
    "ButtonTextOffsetRatio" "0.04"
    "ButtonFontSizeRatio" "0.6"
    "ButtonActiveColor" { "x" "0.6" "y" "0.4" "z" "0.8" "w" "1.0"}
    "ButtonNotActiveColor" { "x" "0.4" "y" "0.2" "z" "0.6" "w" "1.0"}
    "ButtonActivatedTextColorAppearanceSpeed" "14.0"

    "MainMenuButtonFontPath" "resources/fonts/arimo-latin-400-normal.ttf"
    "MainMenuButtonFontBoldPath" "resources/fonts/arimo-latin-700-normal.ttf"

    "Buttons" [
        {
            "text" "Resume"
            "concommand" "menu_pause"
            "exclusivity" "2"
        }
        {
            "text" "Dear ImGUI demo window"
            "concommand" "ui_showdemo"
            "exclusivity" "0"
        }
        {
            "text" "Console"
            "concommand" "ui_showconsole"
            "exclusivity" "0"
        }
        {
            "text" "New game"
            "concommand" "menu_newgame"
            "exclusivity" "0"
        }
        {
            "text" "Save"
            "concommand" "menu_save"
            "exclusivity" "2"
        }
        {
            "text" "Load"
            "concommand" "menu_load"
            "exclusivity" "0"
        }
        {
            "text" "Quit to main menu"
            "concommand" "menu_quittomainmenu"
            "exclusivity" "2"
        }
        {
            "text" "Quit"
            "concommand" "menu_quit"
            "exclusivity" "0"
        }
    ]
}